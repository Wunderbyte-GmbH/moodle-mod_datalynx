{{!
    @template mod_datalynx/tiny_view_tag_modal

    Context variables required for this template:
    * fieldids.viewselect
    * fieldids.linktext
    * fieldids.urlquery
    * fieldids.cssclass
    * fieldids.ifeditable
    * labels.view
    * labels.linktext
    * labels.urlquery
    * labels.urlqueryhelp
    * labels.cssclass
    * labels.ifeditable
    * labels.ifeditablehelp
    * labels.delete
    * options[] { value, name, selected }
    * showlinkoptions
    * values.linktext
    * values.urlquery
    * values.cssclass
    * values.ifeditable

    Example context (json):
    {
        "fieldids": {
            "viewselect": "dlx-view-select-view",
            "linktext": "dlx-link-text-view",
            "urlquery": "dlx-url-query-view",
            "cssclass": "dlx-css-class-view",
            "ifeditable": "dlx-if-editable-view"
        },
        "labels": {
            "view": "View",
            "linktext": "Link text",
            "urlquery": "URL query",
            "urlqueryhelp": "Separate parameters with | e.g. filter=12|editentries=##entryid## or new=1",
            "cssclass": "CSS class",
            "ifeditable": "Only show if the entry can still be edited there",
            "ifeditablehelp": "Hides the link when the target view has no field the user can edit in this entry.",
            "delete": "Delete tag"
        },
        "options": [
            {"value": "gridview", "name": "Gridview", "selected": true},
            {"value": "tabularview", "name": "Tabular view", "selected": false}
        ],
        "showlinkoptions": true,
        "values": {
            "linktext": "View link",
            "urlquery": "new=1|bar=2",
            "cssclass": "btn btn-primary",
            "ifeditable": true
        }
    }
}}
<div class="form-group">
    <label for="{{fieldids.viewselect}}">{{labels.view}}</label>
    <select class="form-control custom-select" id="{{fieldids.viewselect}}" name="{{fieldids.viewselect}}" data-region="tag-view-select">
        {{#options}}
            <option value="{{value}}"{{#selected}} selected="selected"{{/selected}}>{{name}}</option>
        {{/options}}
    </select>
</div>

{{#showlinkoptions}}
    <div class="form-group">
        <label for="{{fieldids.linktext}}">{{labels.linktext}}</label>
        <input type="text" class="form-control" id="{{fieldids.linktext}}" name="{{fieldids.linktext}}" value="{{values.linktext}}" data-region="tag-linktext-input">
    </div>
    <div class="form-group">
        <label for="{{fieldids.urlquery}}">{{labels.urlquery}}</label>
        <input type="text" class="form-control" id="{{fieldids.urlquery}}" name="{{fieldids.urlquery}}" value="{{values.urlquery}}" data-region="tag-urlquery-input">
        {{#labels.urlqueryhelp}}<small class="form-text text-muted" data-region="tag-urlquery-help">{{{labels.urlqueryhelp}}}</small>{{/labels.urlqueryhelp}}
    </div>
    <div class="form-group">
        <label for="{{fieldids.cssclass}}">{{labels.cssclass}}</label>
        <input type="text" class="form-control" id="{{fieldids.cssclass}}" name="{{fieldids.cssclass}}" value="{{values.cssclass}}" data-region="tag-cssclass-input">
    </div>
    <div class="form-check mb-3">
        <input type="checkbox" class="form-check-input" id="{{fieldids.ifeditable}}" name="{{fieldids.ifeditable}}" value="1"{{#values.ifeditable}} checked{{/values.ifeditable}} data-region="tag-ifeditable-input">
        <label class="form-check-label" for="{{fieldids.ifeditable}}">{{labels.ifeditable}}</label>
        {{#labels.ifeditablehelp}}<small class="form-text text-muted d-block" data-region="tag-ifeditable-help">{{labels.ifeditablehelp}}</small>{{/labels.ifeditablehelp}}
    </div>
{{/showlinkoptions}}

<div class="mt-2">
    <button type="button" class="btn btn-danger btn-sm" data-action="dlx-delete" data-region="delete-tag">{{labels.delete}}</button>
</div>
