{{!
    @template mod_datalynx/mobile/view_page

    Moodle App: browse the entries of a datalynx activity.

    Rendered on the server, compiled by Angular in the app. The delimiters are switched to <% %>
    so that the double curly braces stay Angular's. Everything the page shows comes from
    CONTENT_OTHERDATA.state (see \mod_datalynx\output\mobile::otherdata()) through property bindings; only the two ids below are written into the source.

    Example context (json):
    {
        "cmid": 12,
        "courseid": 3
    }
}}
{{=<% %>=}}
<div class="mod-datalynx-mobile">
    <core-course-module-description *ngIf="CONTENT_OTHERDATA.state.intro" [description]="CONTENT_OTHERDATA.state.intro"
            component="mod_datalynx" componentId="<% cmid %>"></core-course-module-description>

    <core-empty-box *ngIf="!CONTENT_OTHERDATA.state.hasview" icon="fas-database"
            [message]="'plugin.mod_datalynx.mobilenoview' | translate"></core-empty-box>

    <ion-list *ngIf="CONTENT_OTHERDATA.state.hasview" class="mod-datalynx-mobile-controls">
        <ion-item *ngIf="CONTENT_OTHERDATA.state.views.length > 1">
            <ion-select [label]="'plugin.mod_datalynx.mobileviewselect' | translate" labelPlacement="stacked"
                    interface="action-sheet" [value]="CONTENT_OTHERDATA.state.viewid"
                    (ionChange)="$event.detail.value !== CONTENT_OTHERDATA.state.viewid && updateContent({
                        cmid: <% cmid %>, courseid: <% courseid %>, viewid: $event.detail.value
                    })">
                <ion-select-option *ngFor="let view of CONTENT_OTHERDATA.state.views" [value]="view.id">{{ view.name }}</ion-select-option>
            </ion-select>
        </ion-item>
        <ion-item *ngIf="CONTENT_OTHERDATA.state.canfilter && CONTENT_OTHERDATA.state.filters.length">
            <ion-select [label]="'plugin.mod_datalynx.mobilefilterselect' | translate" labelPlacement="stacked"
                    interface="action-sheet" [value]="CONTENT_OTHERDATA.state.filterid"
                    (ionChange)="$event.detail.value !== CONTENT_OTHERDATA.state.filterid && updateContent({
                        cmid: <% cmid %>, courseid: <% courseid %>, viewid: CONTENT_OTHERDATA.state.viewid,
                        filterid: $event.detail.value, search: CONTENT_OTHERDATA.state.search,
                        criteria: CONTENT_OTHERDATA.state.criteria, sort: CONTENT_OTHERDATA.state.sort
                    })">
                <ion-select-option [value]="0">{{ 'plugin.mod_datalynx.mobilefilterdefault' | translate }}</ion-select-option>
                <ion-select-option *ngFor="let filter of CONTENT_OTHERDATA.state.filters" [value]="filter.id">{{ filter.name }}</ion-select-option>
            </ion-select>
        </ion-item>
    </ion-list>

    <ng-container *ngIf="CONTENT_OTHERDATA.state.supported && CONTENT_OTHERDATA.state.customfilters.length">
    <div class="ion-padding-horizontal mod-datalynx-mobile-customfilters">
        <ion-chip *ngFor="let cf of CONTENT_OTHERDATA.state.customfilters" [outline]="!cf.active"
                core-site-plugins-new-content [samePage]="true"
                [args]="{cmid: <% cmid %>, courseid: <% courseid %>, viewid: CONTENT_OTHERDATA.state.viewid, customfilterid: cf.active ? 0 : cf.id}">
            <ion-icon name="fas-filter" aria-hidden="true"></ion-icon>
            <ion-label>{{ cf.name }}</ion-label>
        </ion-chip>
    </div>
    </ng-container>

    <ng-container *ngIf="CONTENT_OTHERDATA.state.customfilter">
    <form name="dlxcustomfilter" class="mod-datalynx-mobile-customfilter">
        <ion-list>
            <ng-container *ngFor="let c of CONTENT_OTHERDATA.state.customfilter.controls">
                <ion-item *ngIf="c.control === 'text'">
                    <ion-input [label]="c.name" labelPlacement="stacked" [name]="'cf_' + c.key" [value]="c.value"></ion-input>
                </ion-item>
                <ng-container *ngIf="c.control === 'range' || c.control === 'daterange'">
                    <ion-item>
                        <ion-input [label]="c.name + ': ' + ('plugin.mod_datalynx.customfilterfrom' | translate)" labelPlacement="stacked"
                                [type]="c.control === 'daterange' ? 'date' : 'text'" [attr.inputmode]="c.control === 'range' ? 'decimal' : null"
                                [name]="'cf_' + c.key + '_from'" [value]="c.from"></ion-input>
                    </ion-item>
                    <ion-item>
                        <ion-input [label]="c.name + ': ' + ('plugin.mod_datalynx.customfilterto' | translate)" labelPlacement="stacked"
                                [type]="c.control === 'daterange' ? 'date' : 'text'" [attr.inputmode]="c.control === 'range' ? 'decimal' : null"
                                [name]="'cf_' + c.key + '_to'" [value]="c.to"></ion-input>
                    </ion-item>
                </ng-container>
                <ion-item *ngIf="c.control === 'select' || c.control === 'multiselect'">
                    <ion-select [label]="c.name" labelPlacement="stacked" [multiple]="true" [name]="'cf_' + c.key" [value]="c.selected"
                            interface="alert">
                        <ion-select-option *ngFor="let o of c.options" [value]="o.value">{{ o.label }}</ion-select-option>
                    </ion-select>
                </ion-item>
                <ion-item *ngIf="c.control === 'multiselect'">
                    <ion-select [label]="c.name" labelPlacement="stacked" [name]="'cf_' + c.key + '_mode'" [value]="c.mode"
                            interface="popover">
                        <ion-select-option value="any">{{ 'plugin.mod_datalynx.customfilterany' | translate }}</ion-select-option>
                        <ion-select-option value="all">{{ 'plugin.mod_datalynx.customfilterall' | translate }}</ion-select-option>
                    </ion-select>
                </ion-item>
                <ion-item *ngIf="c.control === 'approve' || c.control === 'status'">
                    <ion-select [label]="c.name" labelPlacement="stacked" [name]="'cf_' + c.key" [value]="c.value" interface="popover">
                        <ion-select-option value="">{{ 'core.choosedots' | translate }}</ion-select-option>
                        <ion-select-option *ngFor="let o of c.options" [value]="o.value">{{ o.label }}</ion-select-option>
                    </ion-select>
                </ion-item>
                <ion-item *ngIf="c.control === 'presence'">
                    <ion-select [label]="c.name" labelPlacement="stacked" [name]="'cf_' + c.key" [value]="c.value" interface="popover">
                        <ion-select-option value="">{{ 'core.choosedots' | translate }}</ion-select-option>
                        <ion-select-option value="exists">{{ 'plugin.mod_datalynx.fileexist' | translate }}</ion-select-option>
                        <ion-select-option value="missing">{{ 'plugin.mod_datalynx.filemissing' | translate }}</ion-select-option>
                    </ion-select>
                </ion-item>
            </ng-container>
            <ng-container *ngIf="CONTENT_OTHERDATA.state.customfilter.sortfields.length">
                <ion-item>
                    <ion-select [label]="'plugin.mod_datalynx.mobilesortby' | translate" labelPlacement="stacked" name="cf_sort"
                            [value]="CONTENT_OTHERDATA.state.customfilter.sort" interface="popover">
                        <ion-select-option value="">{{ 'core.choosedots' | translate }}</ion-select-option>
                        <ion-select-option *ngFor="let o of CONTENT_OTHERDATA.state.customfilter.sortfields" [value]="o.value">{{ o.label }}</ion-select-option>
                    </ion-select>
                </ion-item>
                <ion-item>
                    <ion-select [label]="'plugin.mod_datalynx.mobilesortdirection' | translate" labelPlacement="stacked" name="cf_sortdir"
                            [value]="CONTENT_OTHERDATA.state.customfilter.sortdir" interface="popover">
                        <ion-select-option value="0">{{ 'plugin.mod_datalynx.mobilesortascending' | translate }}</ion-select-option>
                        <ion-select-option value="1">{{ 'plugin.mod_datalynx.mobilesortdescending' | translate }}</ion-select-option>
                    </ion-select>
                </ion-item>
            </ng-container>
        </ion-list>
        <ng-container *ngIf="CONTENT_OTHERDATA.state.customfilter.unsupported.length">
            <p class="ion-padding-horizontal">
                {{ 'plugin.mod_datalynx.mobilefilterunsupported' | translate: {$a: CONTENT_OTHERDATA.state.customfilter.unsupported.join(', ')} }}
            </p>
        </ng-container>
        <div class="ion-padding-horizontal">
            <ion-button expand="block" type="button" form="dlxcustomfilter" core-site-plugins-new-content [samePage]="true"
                    [args]="{cmid: <% cmid %>, courseid: <% courseid %>, viewid: CONTENT_OTHERDATA.state.viewid,
                        customfilterid: CONTENT_OTHERDATA.state.customfilter.id, cfapply: 1}">
                {{ 'plugin.mod_datalynx.mobileapplyfilter' | translate }}
            </ion-button>
            <ion-button expand="block" fill="outline" type="button" core-site-plugins-new-content [samePage]="true"
                    [args]="{cmid: <% cmid %>, courseid: <% courseid %>, viewid: CONTENT_OTHERDATA.state.viewid,
                        customfilterid: CONTENT_OTHERDATA.state.customfilter.id, cfapply: 1}">
                {{ 'plugin.mod_datalynx.mobileclearfilters' | translate }}
            </ion-button>
        </div>
    </form>
    </ng-container>

    <core-search-box *ngIf="CONTENT_OTHERDATA.state.hasview && CONTENT_OTHERDATA.state.supported && CONTENT_OTHERDATA.state.canfilter"
            [searchText]="CONTENT_OTHERDATA.state.search" [lengthCheck]="1" [showClear]="true"
            [placeholder]="'plugin.mod_datalynx.mobilesearchentries' | translate" [searchLabel]="'core.search' | translate"
            (onSubmit)="$event !== CONTENT_OTHERDATA.state.search && updateContent({
                cmid: <% cmid %>, courseid: <% courseid %>, viewid: CONTENT_OTHERDATA.state.viewid,
                filterid: CONTENT_OTHERDATA.state.filterid, search: $event,
                criteria: CONTENT_OTHERDATA.state.criteria, sort: CONTENT_OTHERDATA.state.sort,
                customfilterid: CONTENT_OTHERDATA.state.customfilterid, customvalues: CONTENT_OTHERDATA.state.customvalues
            })"
            (onClear)="CONTENT_OTHERDATA.state.search !== '' && updateContent({
                cmid: <% cmid %>, courseid: <% courseid %>, viewid: CONTENT_OTHERDATA.state.viewid,
                filterid: CONTENT_OTHERDATA.state.filterid, search: '',
                criteria: CONTENT_OTHERDATA.state.criteria, sort: CONTENT_OTHERDATA.state.sort,
                customfilterid: CONTENT_OTHERDATA.state.customfilterid, customvalues: CONTENT_OTHERDATA.state.customvalues
            })"></core-search-box>

    <ion-card *ngIf="CONTENT_OTHERDATA.state.hasview && !CONTENT_OTHERDATA.state.supported">
        <ion-card-content>
            <p>{{ 'plugin.mod_datalynx.mobileviewnotsupported' | translate }}</p>
            <ion-button expand="block" fill="outline" [href]="CONTENT_OTHERDATA.state.browserurl" core-link autoLogin="yes">
                {{ 'plugin.mod_datalynx.mobileopeninbrowser' | translate }}
            </ion-button>
        </ion-card-content>
    </ion-card>

    <ng-container *ngIf="CONTENT_OTHERDATA.state.hasview && CONTENT_OTHERDATA.state.supported">
        <ng-container *ngIf="CONTENT_OTHERDATA.state.canadd">
            <div class="ion-padding-horizontal">
                <ion-button expand="block" core-site-plugins-new-content component="mod_datalynx" method="mobile_edit_entry"
                        [title]="'plugin.mod_datalynx.entryaddnew' | translate"
                        [args]="{cmid: <% cmid %>, courseid: <% courseid %>, viewid: CONTENT_OTHERDATA.state.viewid, entryid: 0}">
                    <ion-icon name="fas-plus" slot="start" aria-hidden="true"></ion-icon>
                    {{ 'plugin.mod_datalynx.entryaddnew' | translate }}
                </ion-button>
            </div>
        </ng-container>
        <ng-container *ngIf="CONTENT_OTHERDATA.state.entriesfiltercount">
            <p class="ion-padding-horizontal mod-datalynx-mobile-count">
                {{ 'plugin.mod_datalynx.mobileshowingxofy' | translate: { $a: {
                    count: CONTENT_OTHERDATA.state.entries.length, total: CONTENT_OTHERDATA.state.entriesfiltercount
                } } }}
            </p>
        </ng-container>

        <core-empty-box *ngIf="!CONTENT_OTHERDATA.state.entries.length" icon="fas-database"
                [message]="CONTENT_OTHERDATA.state.emptycontent"></core-empty-box>

        <ion-card *ngFor="let entry of CONTENT_OTHERDATA.state.entries" class="mod-datalynx-mobile-entry">
            <ion-card-content *ngIf="entry.html">
                <core-format-text [text]="entry.html" component="mod_datalynx" [componentId]="<% cmid %>"
                        contextLevel="module" [contextInstanceId]="<% cmid %>" [courseId]="<% courseid %>"></core-format-text>
            </ion-card-content>
            <ion-list *ngIf="!entry.html" lines="none">
                <ion-item *ngFor="let field of entry.fields" class="ion-text-wrap">
                    <ion-label>
                        <p class="item-heading">{{ field.name }}</p>
                        <core-format-text [text]="field.valuehtml" component="mod_datalynx" [componentId]="<% cmid %>"
                                contextLevel="module" [contextInstanceId]="<% cmid %>" [courseId]="<% courseid %>"></core-format-text>
                    </ion-label>
                </ion-item>
            </ion-list>
            <ion-card-content *ngIf="entry.canedit || entry.candelete" class="mod-datalynx-mobile-actions">
                <ion-button *ngIf="entry.canedit" fill="clear" size="small" core-site-plugins-new-content
                        component="mod_datalynx" method="mobile_edit_entry" [title]="'core.edit' | translate"
                        [args]="{cmid: <% cmid %>, courseid: <% courseid %>, viewid: CONTENT_OTHERDATA.state.viewid, entryid: entry.id}">
                    <ion-icon name="fas-pen" slot="start" aria-hidden="true"></ion-icon>
                    {{ 'core.edit' | translate }}
                </ion-button>
                <ion-button *ngIf="entry.candelete" fill="clear" color="danger" size="small" core-site-plugins-call-ws
                        name="mod_datalynx_delete_entry"
                        [params]="{d: CONTENT_OTHERDATA.state.datalynxid, viewid: CONTENT_OTHERDATA.state.viewid, entryid: entry.id}"
                        [preSets]="{getFromCache: false, saveToCache: false}"
                        [confirmMessage]="'plugin.mod_datalynx.entrydeleteconfirm' | translate"
                        [successMessage]="'plugin.mod_datalynx.entrydeleted' | translate"
                        refreshOnSuccess="true">
                    <ion-icon name="fas-trash" slot="start" aria-hidden="true"></ion-icon>
                    {{ 'core.delete' | translate }}
                </ion-button>
            </ion-card-content>
        </ion-card>

        <core-infinite-loading [enabled]="CONTENT_OTHERDATA.state.cangrow" (action)="updateContent({
                    cmid: <% cmid %>, courseid: <% courseid %>, viewid: CONTENT_OTHERDATA.state.viewid,
                    filterid: CONTENT_OTHERDATA.state.filterid, search: CONTENT_OTHERDATA.state.search,
                    criteria: CONTENT_OTHERDATA.state.criteria, sort: CONTENT_OTHERDATA.state.sort,
                    perpage: CONTENT_OTHERDATA.state.nextperpage,
                    customfilterid: CONTENT_OTHERDATA.state.customfilterid, customvalues: CONTENT_OTHERDATA.state.customvalues
                }); $event()"></core-infinite-loading>

        <ion-card *ngIf="!CONTENT_OTHERDATA.state.cangrow && CONTENT_OTHERDATA.state.entries.length < CONTENT_OTHERDATA.state.entriesfiltercount">
            <ion-card-content>
                <ion-button expand="block" fill="outline" [href]="CONTENT_OTHERDATA.state.browserurl" core-link autoLogin="yes">
                    {{ 'plugin.mod_datalynx.mobileopeninbrowser' | translate }}
                </ion-button>
            </ion-card-content>
        </ion-card>
    </ng-container>
</div>
