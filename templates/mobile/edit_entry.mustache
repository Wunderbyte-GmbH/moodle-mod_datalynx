{{!
    @template mod_datalynx/mobile/edit_entry

    Moodle App: add or edit an entry.

    Rendered on the server, compiled by Angular in the app; the delimiters are switched to <% %>
    so that the double curly braces stay Angular's. The form comes from CONTENT_OTHERDATA.state
    (see \mod_datalynx\output\mobile::mobile_edit_entry()): the parts of the view's entry template
    in order (HTML, links, and the place of each field), each field as one block switching on its
    control. The inputs are named ef_{fieldid}__{input}; Save sends them with the form.

    Example context (json):
    {
        "cmid": 12,
        "courseid": 3
    }
}}
{{=<% %>=}}
<div class="mod-datalynx-mobile mod-datalynx-mobile-edit">
    <ng-container *ngIf="CONTENT_OTHERDATA.state.message">
        <ion-card [color]="CONTENT_OTHERDATA.state.saved ? 'success' : 'danger'">
            <ion-card-content>{{ CONTENT_OTHERDATA.state.message }}</ion-card-content>
        </ion-card>
    </ng-container>

    <ng-container *ngIf="!CONTENT_OTHERDATA.state.allowed">
        <ion-card>
            <ion-card-content>{{ CONTENT_OTHERDATA.state.denyreason }}</ion-card-content>
        </ion-card>
    </ng-container>

    <ng-container *ngIf="CONTENT_OTHERDATA.state.allowed && !CONTENT_OTHERDATA.state.supported">
        <ion-card>
            <ion-card-content>
                <p>{{ 'plugin.mod_datalynx.mobileunsupportedfields' | translate: {$a: CONTENT_OTHERDATA.state.unsupportedlist} }}</p>
                <ion-button expand="block" fill="outline" [href]="CONTENT_OTHERDATA.state.browserurl" core-link autoLogin="yes">
                    {{ 'plugin.mod_datalynx.mobileopeninbrowser' | translate }}
                </ion-button>
            </ion-card-content>
        </ion-card>
    </ng-container>

    <ng-container *ngIf="CONTENT_OTHERDATA.state.allowed && CONTENT_OTHERDATA.state.supported">
    <form name="dlxeditentry">
        <ion-list class="mod-datalynx-mobile-entry">
            <!-- The entry template of the view: its HTML, links to other views and the place of each input. -->
            <ng-container *ngFor="let part of CONTENT_OTHERDATA.state.parts">
            <core-format-text *ngIf="part.html" class="mod-datalynx-mobile-template ion-padding-horizontal" [text]="part.html"
                    component="mod_datalynx" [componentId]="<% cmid %>" contextLevel="module" [contextInstanceId]="<% cmid %>"
                    [courseId]="<% courseid %>"></core-format-text>
            <ng-container *ngIf="part.link">
                <div class="ion-padding-horizontal">
                    <ion-button *ngIf="part.link.method" class="mod-datalynx-mobile-link" [fill]="part.link.fill"
                            [expand]="part.link.expand ? 'block' : undefined" core-site-plugins-new-content component="mod_datalynx"
                            [method]="part.link.method" [title]="part.link.title || part.link.label"
                            [args]="{cmid: <% cmid %>, courseid: <% courseid %>, viewid: part.link.viewid, entryid: part.link.entryid,
                                filterid: part.link.filterid, eids: part.link.eids}" [preSets]="{getFromCache: false}">
                        {{ part.link.label }}
                    </ion-button>
                    <ion-button *ngIf="!part.link.method" class="mod-datalynx-mobile-link" [fill]="part.link.fill"
                            [expand]="part.link.expand ? 'block' : undefined" [href]="part.link.url" core-link autoLogin="yes">
                        {{ part.link.label }}
                        <ion-icon name="fas-up-right-from-square" slot="end" aria-hidden="true"></ion-icon>
                    </ion-button>
                </div>
            </ng-container>
            <ng-container *ngFor="let f of (part.isfield ? [CONTENT_OTHERDATA.state.fields[part.field]] : [])">
                <!-- Hidden controls (e.g. the identifier flag) are filled in by the server on save. -->
                <ion-item *ngIf="f.control === 'static'" class="ion-text-wrap">
                    <ion-label>
                        <p class="item-heading">{{ f.name }}</p>
                        <core-format-text [text]="f.html" component="mod_datalynx" [componentId]="<% cmid %>"
                                contextLevel="module" [contextInstanceId]="<% cmid %>" [courseId]="<% courseid %>"></core-format-text>
                    </ion-label>
                </ion-item>
                <ng-container *ngIf="f.control === 'text' || f.control === 'number' || f.control === 'url' || f.control === 'duration'">
                    <ion-item *ngFor="let i of f.inputs">
                        <ion-input class="mod-datalynx-mobile-control" labelPlacement="stacked" [name]="i.formname" [value]="i.show"
                                [label]="(i.name === 'alt' ? ('plugin.mod_datalynx.mobilelinktext' | translate)
                                    : f.control === 'duration' ? f.name + ' (' + ('plugin.mod_datalynx.mobileminutes' | translate) + ')'
                                    : f.name) + (f.required && i.name !== 'alt' ? ' *' : '')"
                                [type]="f.control === 'number' || f.control === 'duration' ? 'text' : (i.name === 'url' ? 'url' : 'text')"
                                [attr.inputmode]="f.control === 'duration' ? 'decimal' : f.inputmode"></ion-input>
                    </ion-item>
                </ng-container>
                <ion-item *ngIf="f.control === 'textarea'">
                    <ion-textarea class="mod-datalynx-mobile-control" labelPlacement="stacked" [label]="f.name + (f.required ? ' *' : '')" [autoGrow]="true"
                            [name]="f.inputs[0].formname" [value]="f.inputs[0].show"></ion-textarea>
                </ion-item>
                <ion-item *ngIf="f.control === 'datetime'">
                    <ion-input class="mod-datalynx-mobile-control" labelPlacement="stacked" [label]="f.name + (f.required ? ' *' : '')"
                            [type]="f.includetime ? 'datetime-local' : 'date'"
                            [name]="f.inputs[0].formname" [value]="f.inputs[0].show"></ion-input>
                </ion-item>
                <ion-item *ngIf="f.control === 'select' || f.control === 'radio' || f.control === 'multiselect' || f.control === 'checkbox'">
                    <!-- The label in its slot wraps; a label attribute would be cut off after one line. -->
                    <ion-select class="mod-datalynx-mobile-control" labelPlacement="stacked" interface="alert"
                            [multiple]="f.multiple" [name]="f.inputs[0].formname" [value]="f.inputs[0].show">
                        <div slot="label" class="mod-datalynx-mobile-label">{{ f.name + (f.required ? ' *' : '') }}</div>
                        <ion-select-option *ngIf="!f.multiple" value="">{{ 'core.choosedots' | translate }}</ion-select-option>
                        <ion-select-option *ngFor="let o of f.choices" [value]="o.value" [disabled]="o.disabled">{{ o.label }}</ion-select-option>
                    </ion-select>
                </ion-item>
                <!-- An itinerary: one address per stop, looked up on save. Stops can be added, removed and moved. -->
                <ng-container *ngIf="f.control === 'itinerary'">
                    <ion-item lines="none" class="ion-text-wrap">
                        <ion-label><p class="item-heading">{{ f.name + (f.required ? ' *' : '') }}</p></ion-label>
                    </ion-item>
                    <ion-item *ngFor="let s of f.stops; let i = index; let last = last">
                        <ion-input class="mod-datalynx-mobile-control" labelPlacement="stacked"
                                [label]="i === 0 ? f.labels.start : (last ? f.labels.end : f.labels.via)"
                                [name]="f.formnames.waypoints + '__' + i" [value]="s.address"
                                (ionInput)="s.address = $event.detail.value"></ion-input>
                        <ion-button *ngIf="i > 0" slot="end" fill="clear" type="button" [attr.aria-label]="f.labels.up"
                                (click)="f.stops.splice(i - 1, 0, f.stops.splice(i, 1)[0])">
                            <ion-icon name="fas-arrow-up" aria-hidden="true"></ion-icon>
                        </ion-button>
                        <ion-button *ngIf="!last" slot="end" fill="clear" type="button" [attr.aria-label]="f.labels.down"
                                (click)="f.stops.splice(i + 1, 0, f.stops.splice(i, 1)[0])">
                            <ion-icon name="fas-arrow-down" aria-hidden="true"></ion-icon>
                        </ion-button>
                        <ion-button *ngIf="f.stops.length > 2" slot="end" fill="clear" color="danger" type="button"
                                [attr.aria-label]="f.labels.remove" (click)="f.stops.splice(i, 1)">
                            <ion-icon name="fas-xmark" aria-hidden="true"></ion-icon>
                        </ion-button>
                    </ion-item>
                    <ion-item *ngIf="f.stops.length < f.maxstops" lines="none">
                        <ion-button fill="outline" size="small" type="button" (click)="f.stops.splice(f.stops.length - 1, 0, {address: ''})">
                            <ion-icon name="fas-plus" slot="start" aria-hidden="true"></ion-icon>
                            {{ f.labels.add }}
                        </ion-button>
                    </ion-item>
                </ng-container>
                <!-- A schedule: once on a date, or weekly on some days; the departure, and the arrival if asked for. -->
                <ng-container *ngIf="f.control === 'schedule'">
                    <ion-item lines="none" class="ion-text-wrap">
                        <ion-label><p class="item-heading">{{ f.name + (f.required ? ' *' : '') }}</p></ion-label>
                    </ion-item>
                    <ion-item *ngIf="f.modes.length > 1">
                        <ion-select class="mod-datalynx-mobile-control" labelPlacement="stacked" interface="alert"
                                [name]="f.formnames.mode" [value]="f.mode" (ionChange)="f.mode = $event.detail.value">
                            <div slot="label" class="mod-datalynx-mobile-label">{{ f.labels.mode }}</div>
                            <ion-select-option *ngFor="let o of f.modes" [value]="o.value">{{ o.label }}</ion-select-option>
                        </ion-select>
                    </ion-item>
                    <ion-item *ngIf="f.mode === 'once'">
                        <ion-input class="mod-datalynx-mobile-control" labelPlacement="stacked" type="date" [label]="f.labels.date"
                                [name]="f.formnames.date" [value]="f.show.date"></ion-input>
                    </ion-item>
                    <ion-item *ngIf="f.mode === 'weekly'">
                        <ion-select class="mod-datalynx-mobile-control" labelPlacement="stacked" interface="alert" [multiple]="true"
                                [name]="f.daysname" [value]="f.days">
                            <div slot="label" class="mod-datalynx-mobile-label">{{ f.labels.days }}</div>
                            <ion-select-option *ngFor="let o of f.weekdays" [value]="o.value">{{ o.label }}</ion-select-option>
                        </ion-select>
                    </ion-item>
                    <ion-item>
                        <ion-select class="mod-datalynx-mobile-control" labelPlacement="stacked" interface="alert"
                                [name]="f.formnames.start" [value]="f.show.start">
                            <div slot="label" class="mod-datalynx-mobile-label">{{ f.labels.start }}</div>
                            <ion-select-option *ngFor="let o of f.times" [value]="o.value">{{ o.label }}</ion-select-option>
                        </ion-select>
                    </ion-item>
                    <ion-item *ngIf="f.formnames.end">
                        <ion-select class="mod-datalynx-mobile-control" labelPlacement="stacked" interface="alert"
                                [name]="f.formnames.end" [value]="f.show.end">
                            <div slot="label" class="mod-datalynx-mobile-label">{{ f.labels.end }}</div>
                            <ion-select-option value="">{{ 'core.choosedots' | translate }}</ion-select-option>
                            <ion-select-option *ngFor="let o of f.times" [value]="o.value">{{ o.label }}</ion-select-option>
                        </ion-select>
                    </ion-item>
                    <ng-container *ngIf="f.mode === 'weekly'">
                        <ion-item>
                            <ion-input class="mod-datalynx-mobile-control" labelPlacement="stacked" type="date" [label]="f.labels.from"
                                    [name]="f.formnames.from" [value]="f.show.from"></ion-input>
                        </ion-item>
                        <ion-item>
                            <ion-input class="mod-datalynx-mobile-control" labelPlacement="stacked" type="date" [label]="f.labels.until"
                                    [name]="f.formnames.until" [value]="f.show.until"></ion-input>
                        </ion-item>
                    </ng-container>
                </ng-container>
                <ng-container *ngIf="f.error">
                    <ion-item lines="none">
                        <ion-note color="danger">{{ f.error }}</ion-note>
                    </ion-item>
                </ng-container>
            </ng-container>
            </ng-container>
        </ion-list>
        <ng-container *ngIf="CONTENT_OTHERDATA.state.unsupportedfields.length">
            <p class="ion-padding-horizontal">
                {{ 'plugin.mod_datalynx.mobileunsupportedfields' | translate: {$a: CONTENT_OTHERDATA.state.unsupportedlist} }}
            </p>
        </ng-container>
        <div class="ion-padding-horizontal">
            <ng-container *ngIf="CONTENT_OTHERDATA.state.hasstatus">
                <ion-button expand="block" fill="outline" type="button" form="dlxeditentry" core-site-plugins-new-content [samePage]="true"
                        [args]="{cmid: <% cmid %>, courseid: <% courseid %>, viewid: CONTENT_OTHERDATA.state.viewid,
                            entryid: CONTENT_OTHERDATA.state.entryid, save: 1, status: 1}">
                    {{ 'plugin.mod_datalynx.mobilesavedraft' | translate }}
                </ion-button>
                <ion-button expand="block" type="button" form="dlxeditentry" core-site-plugins-new-content [samePage]="true"
                        [args]="{cmid: <% cmid %>, courseid: <% courseid %>, viewid: CONTENT_OTHERDATA.state.viewid,
                            entryid: CONTENT_OTHERDATA.state.entryid, save: 1, status: 2}">
                    {{ 'plugin.mod_datalynx.mobilesubmitentry' | translate }}
                </ion-button>
            </ng-container>
            <ng-container *ngIf="!CONTENT_OTHERDATA.state.hasstatus">
                <ion-button expand="block" type="button" form="dlxeditentry" core-site-plugins-new-content [samePage]="true"
                        [args]="{cmid: <% cmid %>, courseid: <% courseid %>, viewid: CONTENT_OTHERDATA.state.viewid,
                            entryid: CONTENT_OTHERDATA.state.entryid, save: 1}">
                    {{ CONTENT_OTHERDATA.state.submitlabel || ('plugin.mod_datalynx.mobilesaveentry' | translate) }}
                </ion-button>
            </ng-container>
        </div>
    </form>
    </ng-container>
</div>
