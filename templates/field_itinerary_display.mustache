{{!
    @template mod_datalynx/field_itinerary_display

    Display mode output of a datalynxfield_itinerary field.

    The map container carries the whole journey in data attributes so that
    mod_datalynx/itinerary can draw it both on a normal page load and after a view
    browser region was replaced over AJAX. Coordinates are already coarsened by
    the renderer when the viewer is not a participant.

    Context variables required for this template:
    * waypoints - Ordered stops, each with address, lat, lng, seq, isfirst, islast.
    * waypointsjson - The same stops as a JSON string, for the map.
    * showmap - Whether to draw the map.
    * showlist - Whether to list the stops.
    * approximate - Whether the coordinates shown are rounded.
    * lengthlabel - Human readable straight-line journey length.
    * hasroute - Whether a routed distance and travel time are known.
    * routelabel - Human readable road distance.
    * traveltimelabel - Human readable travel time.
    * polyline - Encoded route geometry, empty when unrouted.
    * tileurl, attribution, maxzoom, zoom - Basemap settings.

    Example context (json):
    {
        "waypoints": [
            {"address": "Wien Hauptbahnhof", "lat": 48.185, "lng": 16.377, "seq": 0, "isfirst": true, "islast": false},
            {"address": "Graz Hauptbahnhof", "lat": 47.073, "lng": 15.417, "seq": 1, "isfirst": false, "islast": true}
        ],
        "waypointsjson": "[]",
        "showmap": true,
        "showlist": true,
        "approximate": true,
        "lengthlabel": "Approximately 145.2 km",
        "hasroute": true,
        "routelabel": "195.3 km by road",
        "traveltimelabel": "Travel time approx. 2 h 10 min",
        "polyline": "",
        "tileurl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        "attribution": "OpenStreetMap contributors",
        "maxzoom": 19,
        "zoom": 13
    }
}}
<div class="datalynx-itinerary">
    {{#showlist}}
        <ol class="datalynx-itinerary__stops">
            {{#waypoints}}
                <li class="datalynx-itinerary__stop{{#isfirst}} datalynx-itinerary__stop--start{{/isfirst}}{{#islast}} datalynx-itinerary__stop--end{{/islast}}">
                    <i class="icon fa fa-fw {{#isfirst}}fa-circle-dot{{/isfirst}}{{^isfirst}}{{#islast}}fa-flag-checkered{{/islast}}{{^islast}}fa-circle{{/islast}}{{/isfirst}}" aria-hidden="true"></i>
                    <span class="datalynx-itinerary__address">{{address}}</span>
                </li>
            {{/waypoints}}
        </ol>
        <p class="datalynx-itinerary__meta">
            {{^hasroute}}{{lengthlabel}}{{/hasroute}}
            {{#hasroute}}
                {{routelabel}}
                <span class="datalynx-itinerary__traveltime">
                    <i class="icon fa fa-clock fa-fw" aria-hidden="true"></i>{{traveltimelabel}}
                </span>
            {{/hasroute}}
            {{#approximate}}
                <span class="datalynx-itinerary__approx" title="{{#str}}precision_approximate, datalynxfield_itinerary{{/str}}">
                    <i class="icon fa fa-circle-half-stroke fa-fw" aria-hidden="true"></i>
                    {{#str}}precision_approximate, datalynxfield_itinerary{{/str}}
                </span>
            {{/approximate}}
        </p>
    {{/showlist}}
    {{#showmap}}
        <div class="datalynx-itinerary__map"
             data-region="datalynx-itinerary-map"
             data-waypoints="{{waypointsjson}}"
             data-polyline="{{polyline}}"
             data-zoom="{{zoom}}"
             data-tileurl="{{tileurl}}"
             data-attribution="{{attribution}}"
             data-maxzoom="{{maxzoom}}"
             role="img"
             aria-label="{{#str}}pluginname, datalynxfield_itinerary{{/str}}">
        </div>
    {{/showmap}}
</div>
