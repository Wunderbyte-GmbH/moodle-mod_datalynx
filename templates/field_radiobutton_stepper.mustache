{{!
    @template mod_datalynx/field_radiobutton_stepper

    Displays a stepper progress bar for a radiobutton field.

    A special state (e.g. "Information needed") marks the step it belongs to with a contextual
    style and its label instead of completing it. A special state without a step is shown as
    a notice below the stepper.

    The steps are an ordered list. Each step carries a visually hidden status text (completed,
    current step, not yet reached) and the reached step has aria-current="step", so the progress
    is not conveyed by colour alone.

    Example context (json):
    {
        "label": "Progress",
        "steps": [
            {
                "label": "Step 1",
                "completed": true,
                "icon": "fa fa-shopping-cart",
                "hasicon": true,
                "number": 1,
                "special": false,
                "current": false,
                "statustext": "completed"
            },
            {
                "label": "Step 2",
                "completed": false,
                "icon": "",
                "hasicon": false,
                "number": 2,
                "special": true,
                "current": true,
                "statustext": "current step",
                "style": "warning",
                "statuslabel": "Information needed"
            }
        ],
        "notice": null
    }
}}
<ol class="datalynx-stepper steps d-flex flex-wrap flex-sm-nowrap justify-content-between my-4" aria-label="{{label}}">
    {{#steps}}
        <li class="step{{#completed}} completed{{/completed}}{{#special}} special special-{{style}}{{/special}}"{{#current}} aria-current="step"{{/current}}>
            <div class="step-icon-wrap" aria-hidden="true">
                <div class="step-icon">
                    {{#hasicon}}
                        <i class="{{icon}}" aria-hidden="true"></i>
                    {{/hasicon}}
                    {{^hasicon}}
                        {{number}}
                    {{/hasicon}}
                </div>
            </div>
            <span class="step-title d-block">
                {{label}}<span class="sr-only visually-hidden">, {{statustext}}</span>
                {{#special}}<span class="step-status d-block">{{statuslabel}}</span>{{/special}}
            </span>
        </li>
    {{/steps}}
</ol>
{{#notice}}
    <div class="datalynx-stepper-notice alert alert-{{style}} py-2 px-3" role="status">{{label}}</div>
{{/notice}}
